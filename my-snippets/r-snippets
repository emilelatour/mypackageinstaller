snippet mi
	#### Multiple imputation --------------------------------

	# Dry run to grab and edit the predictor matrix / methods
	ini <- mice::mice(${1:data}, maxit = 0, print = FALSE)
	pred <- ini$predictorMatrix
	meth <- ini$method

	imp <- mice::mice(
		${1:data},
		m = ${2:20},
		method = meth,
		predictorMatrix = pred,
		seed = ${3:2024},
		print = FALSE
	)

	fit <- with(imp, ${4:lm(y ~ x)})
	pooled <- mice::pool(fit)
	summary(pooled, conf.int = TRUE)

